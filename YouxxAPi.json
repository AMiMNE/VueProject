":"conv_zhangsan"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/user":{"post":{"tags":["用户"],"summary":"【管理员】新增用户","description":"请求体为 User 实体，需传 username / password / role / status","operationId":"add","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/User"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultUserVO"}}}}}}},"/api/user/avatar/upload":{"post":{"tags":["用户"],"summary":"上传头像","description":"multipart/form-data 上传；后端会自动压缩并落盘，同时把新路径写回当前用户的 avatar 字段，前端拿到返回的 url 即可直接展示","operationId":"uploadAvatar","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary","description":"图片文件，单文件最大 10MB"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultUploadVO"}}}}}}},"/api/user/address":{"get":{"tags":["用户"],"summary":"查询收货地址列表","operationId":"listAddresses","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultListUserAddress"}}}}}},"post":{"tags":["用户"],"summary":"新增收货地址","description":"user_id 由后端从 token 解析，前端无需传递","operationId":"addAddress","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserAddressRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultUserAddress"}}}}}}},"/api/product":{"post":{"tags":["商品"],"summary":"【管理员】新增商品","description":"请求体为 Product 实体，image_url 建议先调用 /upload 获取","operationId":"add_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultProduct"}}}}}}},"/api/product/upload":{"post":{"tags":["商品"],"summary":"【管理员】上传商品图片","description":"multipart/form-data 上传，返回的 url 直接写入商品的 imageUrl 字段。图片按分类归档到 /upload_resources/products/{categoryId}/ 下","operationId":"upload","parameters":[{"name":"categoryId","in":"query","description":"商品分类 ID，决定图片归档目录","required":true,"schema":{"type":"string"},"example":"drinks"}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary","description":"图片文件，单文件最大 10MB"}},"required":["file"]}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultUploadVO"}}}}}}},"/api/order":{"post":{"tags":["订单"],"summary":"创建订单","description":"前端只需传商品 ID 与数量；订单号、用户名、总金额与商品快照均由后端生成，下单成功后会返回完整订单对象","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderCreateRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultOrder"}}}}}}},"/api/order/{id}/urgent":{"post":{"tags":["订单"],"summary":"催单","description":"用户对未发货订单发起催单，累计 urgentCount 并记录最后催单时间","operationId":"urge","parameters":[{"name":"id","in":"path","description":"订单号","required":true,"schema":{"type":"string"},"example":"ORD20260918001"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/message/send":{"post":{"tags":["消息"],"summary":"发送消息","description":"发送方身份由 token 决定；未传 conversationId 时按 conv_{用户名} 兜底生成，用户首次发起会话无需先创建会话","operationId":"sendMessage","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SendMessageRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultMessage"}}}}}}},"/api/llm/agent/chat":{"post":{"tags":["AI 助手"],"summary":"AI 助手对话","de