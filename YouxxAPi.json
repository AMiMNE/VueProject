,"summary":"查询订单详情","description":"返回订单主体与明细列表","operationId":"detail_2","parameters":[{"name":"id","in":"path","description":"订单号","required":true,"schema":{"type":"string"},"example":"ORD20260918001"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultOrderDetailVO"}}}}}},"delete":{"tags":["订单"],"summary":"删除订单","operationId":"delete_2","parameters":[{"name":"id","in":"path","description":"订单号","required":true,"schema":{"type":"string"},"example":"ORD20260918001"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultVoid"}}}}}}},"/api/order/my":{"get":{"tags":["订单"],"summary":"查询我的订单","description":"用户 ID 取自 token，前端只需按状态过滤","operationId":"myOrders","parameters":[{"name":"status","in":"query","description":"状态过滤: PENDING / SHIPPED / COMPLETED / CANCELLED，不传返回全部","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultListOrder"}}}}}}},"/api/order/list":{"get":{"tags":["订单"],"summary":"【管理员】分页查询订单列表","description":"支持关键字、状态与下单时间区间过滤","operationId":"list_2","parameters":[{"name":"keyword","in":"query","description":"关键字，匹配订单号或用户名","required":false,"schema":{"type":"string"},"example":"ORD2026"},{"name":"status","in":"query","description":"状态过滤: PENDING / SHIPPED / COMPLETED / CANCELLED","required":false,"schema":{"type":"string"},"example":"PENDING"},{"name":"beginTime","in":"query","description":"下单时间起（含），格式 yyyy-MM-dd HH:mm:ss","required":false,"schema":{"type":"string","format":"date-time"},"example":"2026-09-01 00:00:00"},{"name":"endTime","in":"query","description":"下单时间止（含），格式 yyyy-MM-dd HH:mm:ss","required":false,"schema":{"type":"string","format":"date-time"},"example":"2026-09-30 23:59:59"},{"name":"page","in":"query","description":"页码，从 1 开始","required":false,"schema":{"type":"integer","format":"int32","default":1},"example":1}